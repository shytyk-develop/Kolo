# from @BotFather
BOT_TOKEN=123456789:replace-me
BOT_USERNAME=kolo_notify_bot
# 16-256 chars of A-Z a-z 0-9 _ -   e.g.  python -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_SECRET=replace-me-with-a-long-random-string
# shared with the Kolo backend, 24+ chars
