# copy to .env.local
# where /api is proxied to (server side, next.config.ts rewrites); the browser only calls /api
BACKEND_URL=http://localhost:8000
# goes to the browser, never put secrets here: the backend's public url, used for websockets
NEXT_PUBLIC_API_URL=http://localhost:8000
# optional, the same value as KOLO_PROXY_SECRET on the backend: the backend then trusts
# X-Forwarded-For only from this proxy (per-client rate limits that can't be faked)
KOLO_PROXY_SECRET=
