# copy to infra/.env and add the secrets:
#   python -c "import secrets; print('KOLO_JWT_SECRET=' + secrets.token_urlsafe(48))" >> .env
#   python -c "import secrets; print('KOLO_TURN_SECRET=' + secrets.token_urlsafe(32))" >> .env
# compose won't start without them
KOLO_ENV=dev
PUBLIC_HOST=localhost
KOLO_PUBLIC_URL=http://localhost:3000
