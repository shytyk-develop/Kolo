KOLO_ENV=dev
KOLO_DATABASE_URL=postgresql+asyncpg://kolo:kolo@localhost:5432/kolo
KOLO_REDIS_URL=redis://localhost:6379/0
KOLO_JWT_SECRET=your-secret-here
KOLO_CORS_ORIGINS=["http://localhost:3000"]
KOLO_TURN_URLS=["turn:localhost:3478?transport=udp","turn:localhost:3478?transport=tcp"]
KOLO_TURN_SECRET=same-as-static-auth-secret-in-coturn
KOLO_P2P_MAX_PARTICIPANTS=4
KOLO_LIVEKIT_URL=ws://localhost:7880
KOLO_LIVEKIT_API_KEY=devkey
KOLO_LIVEKIT_API_SECRET=secret
# Telegram invites (notify/), all three or Telegram stays off. Not KOLO_-prefixed.
NOTIFY_URL=https://kolo-notify.vercel.app
NOTIFY_API_KEY=same-as-NOTIFY_API_KEY-in-notify
# signs the kolo_tg cookie, 32+ chars
SESSION_SECRET=your-session-secret-here
# behind the frontend's /api proxy (Vercel): client ip from X-Forwarded-For for the per-ip limits
KOLO_TRUST_PROXY=false
